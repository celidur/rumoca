// The delayed value of channel `channel` at `time` (the runtime's
// `delayed_value`, delay.rs): the current source `current` for a zero delay;
// before the history, its first point, or NaN once the ring has dropped the
// points the query needs; the left point for a discrete source
// or an event's equal-time pair; otherwise, between the bracketing points (the
// last one and (time, current) past the history), the cubic or quadratic
// Lagrange stencil over them and one neighbour on each side across strictly
// increasing times, or linear interpolation when it has fewer than three
// finite points.
__device__ double {{ name }}_delay_read(const double *history, int channel, double time, double delay_time, double current, int discrete)
{
    const int capacity = {{ NAME }}_DELAY_CAPACITY;
    int count = (int)history[0];
    int head = (int)history[1];
    int dropped = count > capacity;
    count = dropped ? capacity : count;
    const double *times = history + 2;
    const double *values = history + 2 + (long long)capacity * (long long)(1 + channel);
#define {{ NAME }}_AT(i) ((head + (i)) % capacity)
    double query = time - delay_time;
    if (count <= 0 || (delay_time == 0.0 && times[{{ NAME }}_AT(count - 1)] <= time)) {
        return current;
    }
    if (query <= times[head]) {
        return dropped && query < times[head] ? NAN : values[head];
    }
    // The first point after `query` (`partition_point`); at least one is
    // before it.
    int low = 0;
    int high = count;
    while (low < high) {
        int middle = (low + high) / 2;
        if (times[{{ NAME }}_AT(middle)] <= query) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    int upper = low;
    int lower = upper - 1;
    double lower_time = times[{{ NAME }}_AT(lower)];
    double lower_value = values[{{ NAME }}_AT(lower)];
    if (discrete || (upper < count && times[{{ NAME }}_AT(upper)] == lower_time)) {
        return lower_value;
    }
    double next_time = upper < count ? times[{{ NAME }}_AT(upper)] : time;
    double next_value = upper < count ? values[{{ NAME }}_AT(upper)] : current;
    if (next_time <= lower_time) {
        return next_value;
    }
    double stencil_time[4];
    double stencil_value[4];
    int points = 0;
    if (lower >= 1 && times[{{ NAME }}_AT(lower - 1)] < lower_time) {
        stencil_time[points] = times[{{ NAME }}_AT(lower - 1)];
        stencil_value[points++] = values[{{ NAME }}_AT(lower - 1)];
    }
    stencil_time[points] = lower_time;
    stencil_value[points++] = lower_value;
    stencil_time[points] = next_time;
    stencil_value[points++] = next_value;
    if (upper + 1 < count && times[{{ NAME }}_AT(upper + 1)] > next_time) {
        stencil_time[points] = times[{{ NAME }}_AT(upper + 1)];
        stencil_value[points++] = values[{{ NAME }}_AT(upper + 1)];
    }
#undef {{ NAME }}_AT
    int finite = points >= 3;
    for (int i = 0; i < points; ++i) {
        finite = finite && isfinite(stencil_value[i]);
    }
    if (finite) {
        // Offsets from the lower point, so that a constant run reads back
        // exactly.
        double offset = -0.0;
        for (int i = 0; i < points; ++i) {
            double weight = 1.0;
            for (int j = 0; j < points; ++j) {
                if (j != i) {
                    weight *= (query - stencil_time[j]) / (stencil_time[i] - stencil_time[j]);
                }
            }
            offset += weight * (stencil_value[i] - lower_value);
        }
        double value = lower_value + offset;
        if (isfinite(value)) {
            return value;
        }
    }
    double fraction = (query - lower_time) / (next_time - lower_time);
    fraction = fraction < 0.0 ? 0.0 : (fraction > 1.0 ? 1.0 : fraction);
    return lower_value + fraction * (next_value - lower_value);
}

// Whether `{{ name }}_delay_read` reads the current source of a channel at
// `time`: a zero delay, an empty history, or a query at or past its last
// point.
__device__ int {{ name }}_delay_reads_current(const double *history, double time, double delay_time)
{
    const int capacity = {{ NAME }}_DELAY_CAPACITY;
    int count = (int)history[0];
    count = count > capacity ? capacity : count;
    int head = (int)history[1];
    return count <= 0 || delay_time == 0.0 || time - delay_time >= history[2 + (head + count - 1) % capacity];
}

