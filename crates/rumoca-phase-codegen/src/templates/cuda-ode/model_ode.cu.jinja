    double *scratch = 0;
{%- elif delays.settle_times or delays.settle_sources %}
    double scratch[{{ [y_len, 1] | max }}];
{%- endif %}
{%- if delays.settle_times %}
    view = {{ name }}_delay_settle(time, batch_y, batch_p, scratch);
{%- endif %}
    {{ name }}_delay_times(time, view, batch_p, delay_time);
    {{ name }}_delay_maxima(time, view, batch_p, delay_max);
{%- if delays.settle_sources and not delays.settle_times %}
    int current = 0;
    for (int channel = 0; channel < {{ delays.count }}; ++channel) {
        current |= {{ name }}_delay_reads_current(batch_history, time, delay_time[channel]);
    }
    if (current) {
        view = {{ name }}_delay_settle(time, batch_y, batch_p, scratch);
    }
{%- endif %}
    {{ name }}_delay_sources(time, view, batch_p, sources);
    for (int channel = 0; channel < {{ delays.count }}; ++channel) {
        // A delay time outside [0, delayMax], which the runtime refuses, has
        // no value: the lane reads NaN, which its derivatives carry to the host.
        double value = NAN;
        if (isfinite(delay_time[channel]) && delay_time[channel] >= 0.0 && isfinite(delay_max[channel]) && delay_max[channel] >= delay_time[channel]) {
            value = {{ name }}_delay_read(batch_history, channel, time, delay_time[channel], sources[channel], discrete[channel]);
        }
        batch_p[value_parameter[channel]] = value;
    }
{%- endif %}
}

// Record the accepted point at `time` (after the step that reached it, with
// the delayed values of `time` applied).
extern "C" __global__ void {{ name }}_delay_commit_batch(
    double time,
    double *y,
    const double *p,
    double *history,
    int y_stride,
    int p_stride,
    int history_stride,
    int batch_count)
{
    int batch = blockIdx.x * blockDim.x + threadIdx.x;
    if (batch >= batch_count) {
        return;
    }
    double *batch_y = y + ((long long)batch * (long long)y_stride);
    const double *batch_p = p + ((long long)batch * (long long)p_stride);
    double *batch_history = history + ((long long)batch * (long long)history_stride);
    (void)time;
    (void)batch_y;
    (void)batch_p;
    (void)batch_history;
{%- if delays.count > 0 %}
    double sources[{{ delays.count }}];
    (void){{ name }}_refresh(time, batch_y, batch_p);
    {{ name }}_delay_sources(time, batch_y, batch_p, sources);
    {{ name }}_delay_append(batch_history, time, sources);
{%- endif %}
}

