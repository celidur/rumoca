// One event iteration at `time`: settle the algebraic slots, re-encode every
// relation memory from its root, apply the discrete equations, and repeat
// until nothing changes; then advance the condition memories. Returns the
// number of passes, or -1 when the iteration did not settle.
__device__ int {{ name }}_event_iterate(double time, double *batch_y, double *batch_p)
{
    double roots[{{ [ev.root_count, 1] | max }}];
    double values[{{ [ev.discrete_count, 1] | max }}];
    const int root_index[{{ [nroots, 1] | max }}] = {{ int_list(ev.event_roots | map(attribute="root") | list) }};
    const int memory[{{ [nroots, 1] | max }}] = {{ int_list(ev.event_roots | map(attribute="memory") | list) }};
    const int zero[{{ [nroots, 1] | max }}] = {{ int_list(ev.event_roots | map(attribute="zero") | list) }};
    (void)roots;
    (void)values;
    (void)root_index;
    (void)memory;
    (void)zero;
    int passes = 0;
    int settled = 0;
    for (; passes < {{ NAME }}_EVENT_MAX_PASSES && !settled; ++passes) {
        (void){{ name }}_refresh(time, batch_y, batch_p);
        int changed = 0;
{%- if nroots > 0 %}
        {{ name }}_roots(time, batch_y, batch_p, roots);
        for (int k = 0; k < {{ nroots }}; ++k) {
            double root = roots[root_index[k]];
            if (root == 0.0) {
                root = zero[k] > 0 ? 2.220446049250313e-16 : (zero[k] < 0 ? -2.220446049250313e-16 : root);
            }
            double value = root < 0.0 ? 1.0 : 0.0;
            if (root == 0.0) {
                value = batch_p[memory[k]];
            }
            changed |= batch_p[memory[k]] != value;
            batch_p[memory[k]] = value;
        }
{%- endif %}
{%- if ev.discrete_count > 0 %}
        {{ name }}_discrete_rows(time, batch_y, batch_p, values);
{%- for target in ev.discrete_targets %}
{%- if not ev.discrete_memory[loop.index0] %}
        changed |= batch_{{ target.column }}[{{ target.index }}] != values[{{ loop.index0 }}];
        batch_{{ target.column }}[{{ target.index }}] = values[{{ loop.index0 }}];
{%- endif %}
{%- endfor %}
{%- endif %}
        settled = !changed;
    }
    (void){{ name }}_refresh(time, batch_y, batch_p);
{%- if ev.discrete_count > 0 %}
    {{ name }}_discrete_rows(time, batch_y, batch_p, values);
{%- for target in ev.discrete_targets %}
{%- if ev.discrete_memory[loop.index0] %}
    batch_{{ target.column }}[{{ target.index }}] = values[{{ loop.index0 }}];
{%- endif %}
{%- endfor %}
{%- endif %}
    return settled ? passes : -1;
}

