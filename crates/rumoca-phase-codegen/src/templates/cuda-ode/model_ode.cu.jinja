// ---------------------------------------------------------------------------
// State manifold: lower-order constraints that index reduction replaced by
// differentiated ones. After every accepted step (and after initialization)
// the host launches `{{ name }}_project_manifold_batch`, which moves the
// listed state coordinates by a minimum-norm Gauss-Newton correction back
// onto the constraints so they do not drift.
{%- set manifold = lanes.manifold %}
{%- for blk in manifold.blocks %}
{%- set b = name ~ "_manifold" ~ loop.index0 %}
{%- set n = blk.y | length %}
{{ residual_rows(b, blk.residual_rows, blk.m) }}

__device__ int {{ b }}_project(double time, double *batch_y, const double *batch_p)
{
    const int coordinate[{{ n }}] = {{ int_list(blk.y) }};
    double r[{{ blk.m }}];
    double jacobian[{{ blk.m * n }}];
    double normal[{{ blk.m * blk.m }}];
    for (int iteration = 0; iteration < {{ NAME }}_NEWTON_MAX_ITERATIONS; ++iteration) {
{%- if blk.reads_algebraics %}
        (void){{ name }}_refresh(time, batch_y, batch_p);
{%- endif %}
        int exact = 1;
        for (int i = 0; i < {{ blk.m }}; ++i) {
            r[i] = {{ b }}_row(i, time, batch_y, batch_p);
            if (!isfinite(r[i])) {
                return 2;
            }
            exact &= r[i] == 0.0;
        }
        if (exact) {
            return 0;
        }
        for (int column = 0; column < {{ n }}; ++column) {
            double x = batch_y[coordinate[column]];
            double h = 1.4901161193847656e-08 * fmax(1.0, fabs(x));
            batch_y[coordinate[column]] = x + h;
{%- if blk.reads_algebraics %}
            (void){{ name }}_refresh(time, batch_y, batch_p);
{%- endif %}
            for (int i = 0; i < {{ blk.m }}; ++i) {
                jacobian[i * {{ n }} + column] = ({{ b }}_row(i, time, batch_y, batch_p) - r[i]) / h;
            }
            batch_y[coordinate[column]] = x;
        }
        for (int i = 0; i < {{ blk.m }}; ++i) {
            for (int j = 0; j < {{ blk.m }}; ++j) {
                double sum = 0.0;
                for (int column = 0; column < {{ n }}; ++column) {
                    sum += jacobian[i * {{ n }} + column] * jacobian[j * {{ n }} + column];
                }
                normal[i * {{ blk.m }} + j] = sum;
            }
        }
        if ({{ name }}_lu_solve(normal, r, {{ blk.m }}) != 0) {
            return 1;
        }
        double largest = 0.0;
        for (int column = 0; column < {{ n }}; ++column) {
            double step = 0.0;
            for (int i = 0; i < {{ blk.m }}; ++i) {
                step -= jacobian[i * {{ n }} + column] * r[i];
            }
            double x = batch_y[coordinate[column]];
            batch_y[coordinate[column]] = x + step;
            largest = fmax(largest, fabs(step) / (1.0 + fabs(x)));
        }
        if (largest <= {{ NAME }}_NEWTON_STEP_TOLERANCE) {
            return 0;
        }
    }
    return 3;
}
