// Solve `a x = b` in place (x overwrites b) by LU with partial pivoting on
// the row-major n x n matrix `a`. Returns 0, or 1 for a singular matrix.
__device__ int {{ name }}_lu_solve(double *a, double *b, int n)
{
    for (int i = 0; i < n; ++i) {
        int pivot = i;
        double best = fabs(a[i * n + i]);
        for (int row = i + 1; row < n; ++row) {
            double value = fabs(a[row * n + i]);
            if (value > best) {
                best = value;
                pivot = row;
            }
        }
        if (!(best > 0.0) || !isfinite(best)) {
            return 1;
        }
        if (pivot != i) {
            for (int column = 0; column < n; ++column) {
                double swap = a[i * n + column];
                a[i * n + column] = a[pivot * n + column];
                a[pivot * n + column] = swap;
            }
            double swap = b[i];
            b[i] = b[pivot];
            b[pivot] = swap;
        }
        for (int row = i + 1; row < n; ++row) {
            double factor = a[row * n + i] / a[i * n + i];
            if (factor == 0.0) {
                continue;
            }
            for (int column = i; column < n; ++column) {
                a[row * n + column] -= factor * a[i * n + column];
            }
            b[row] -= factor * b[i];
        }
    }
    for (int i = n - 1; i >= 0; --i) {
        double sum = b[i];
        for (int column = i + 1; column < n; ++column) {
            sum -= a[i * n + column] * b[column];
        }
        b[i] = sum / a[i * n + i];
    }
    return 0;
}

