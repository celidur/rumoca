// Returns 0 when converged, nonzero when the Newton iteration failed.
__device__ int {{ b }}_project(double time, double *batch_y, const double *batch_p)
{
    const int iterated[{{ k }}] = {{ int_list(blk.iterated) }};
    const int residual[{{ k }}] = {{ int_list(blk.residual) }};
    double f[{{ k }}];
    double jacobian[{{ k * k }}];
    int converged = 0;
    for (int iteration = 0; iteration < {{ NAME }}_NEWTON_MAX_ITERATIONS; ++iteration) {
        {{ b }}_sweep(time, batch_y, batch_p);
        int exact = 1;
        for (int i = 0; i < {{ k }}; ++i) {
            f[i] = {{ b }}_row(residual[i], time, batch_y, batch_p);
            if (!isfinite(f[i])) {
                return 2;
            }
            exact &= f[i] == 0.0;
        }
        if (exact || converged) {
            return 0;
        }
        for (int column = 0; column < {{ k }}; ++column) {
            double x = batch_y[iterated[column]];
            double h = 1.4901161193847656e-08 * fmax(1.0, fabs(x));
            batch_y[iterated[column]] = x + h;
            {{ b }}_sweep(time, batch_y, batch_p);
            for (int i = 0; i < {{ k }}; ++i) {
                jacobian[i * {{ k }} + column] = ({{ b }}_row(residual[i], time, batch_y, batch_p) - f[i]) / h;
            }
            batch_y[iterated[column]] = x;
        }
        for (int i = 0; i < {{ k }}; ++i) {
            f[i] = -f[i];
        }
        if ({{ name }}_lu_solve(jacobian, f, {{ k }}) != 0) {
            {{ b }}_sweep(time, batch_y, batch_p);
            return 1;
        }
        double largest = 0.0;
        for (int column = 0; column < {{ k }}; ++column) {
            double x = batch_y[iterated[column]];
            batch_y[iterated[column]] = x + f[column];
            largest = fmax(largest, fabs(f[column]) / (1.0 + fabs(x)));
        }
        converged = largest <= {{ NAME }}_NEWTON_STEP_TOLERANCE;
    }
    {{ b }}_sweep(time, batch_y, batch_p);
    return 3;
}
