// Whether storing `value` over `stored` changes its bits, as the runtime
// compares a slot it writes (a NaN that stays NaN is no change).
__device__ int {{ name }}_changes(double stored, double value)
{
    unsigned long long a;
    unsigned long long b;
    memcpy(&a, &stored, sizeof a);
    memcpy(&b, &value, sizeof b);
    return a != b;
}

// One event iteration at `time`: settle the algebraic slots, re-encode every
// relation memory from its root, apply the discrete equations, and repeat
// until nothing changes; then advance the condition memories. Returns the
// number of passes, or -1 when the iteration did not settle, a refresh
// failed or a root is not finite (the runtime refuses a non-finite root
// condition).
__device__ int {{ name }}_event_iterate(double time, double *batch_y, double *batch_p)
{
    double roots[{{ [ev.root_count, 1] | max }}];
    double values[{{ [ev.discrete_count, 1] | max }}];
    const int root_index[{{ [nroots, 1] | max }}] = {{ int_list(ev.event_roots | map(attribute="root") | list) }};
    const int memory[{{ [nroots, 1] | max }}] = {{ int_list(ev.event_roots | map(attribute="memory") | list) }};
    const int zero[{{ [nroots, 1] | max }}] = {{ int_list(ev.event_roots | map(attribute="zero") | list) }};
    (void)roots;
    (void)values;
    (void)root_index;
    (void)memory;
    (void)zero;
    int passes = 0;
    int settled = 0;
    for (; passes < {{ NAME }}_EVENT_MAX_PASSES && !settled; ++passes) {
        if ({{ name }}_refresh(time, batch_y, batch_p)) {
            return -1;
        }
        int changed = 0;
{%- if nroots + ncross > 0 %}
        {{ name }}_roots(time, batch_y, batch_p, roots);
{%- for crossing in ev.crossings %}
        if (!isfinite(roots[{{ crossing.root }}])) {
            return -1;
        }
{%- endfor %}
        for (int k = 0; k < {{ nroots }}; ++k) {
            double root = roots[root_index[k]];
            if (!isfinite(root)) {
                return -1;
            }
            // The runtime's `orient_typed_root_zero` and
            // `relation_memory_value_from_root`: a zero left unoriented
            // encodes false.
            if (root == 0.0) {
                root = zero[k] > 0 ? 2.220446049250313e-16 : (zero[k] < 0 ? -2.220446049250313e-16 : root);
            }
            double value = root < 0.0 ? 1.0 : 0.0;
            changed |= {{ name }}_changes(batch_p[memory[k]], value);
            batch_p[memory[k]] = value;
        }
{%- endif %}
{%- if ev.discrete_count > 0 %}
        {{ name }}_discrete_rows(time, batch_y, batch_p, values);
{%- for target in ev.discrete_targets %}
{%- if not ev.discrete_memory[loop.index0] %}
        changed |= {{ name }}_changes(batch_{{ target.column }}[{{ target.index }}], values[{{ loop.index0 }}]);
        batch_{{ target.column }}[{{ target.index }}] = values[{{ loop.index0 }}];
{%- endif %}
{%- endfor %}
{%- endif %}
        settled = !changed;
    }
    // A settled pass changed nothing after its own refresh, so the slots are
    // settled already; refresh again only after the last unsettled pass.
    if (!settled && {{ name }}_refresh(time, batch_y, batch_p)) {
        return -1;
    }
{%- if ev.discrete_count > 0 %}
    {{ name }}_discrete_rows(time, batch_y, batch_p, values);
{%- for target in ev.discrete_targets %}
{%- if ev.discrete_memory[loop.index0] %}
    batch_{{ target.column }}[{{ target.index }}] = values[{{ loop.index0 }}];
{%- endif %}
{%- endfor %}
{%- endif %}
    return settled ? passes : -1;
}

