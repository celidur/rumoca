// Solve one row for one unknown (a causal step) by a few secant steps.
__device__ void {{ b }}_isolate(int row, int y_index, double time, double *batch_y, const double *batch_p)
{
    double x = batch_y[y_index];
    double r = {{ b }}_row(row, time, batch_y, batch_p);
    for (int iteration = 0; iteration < 8 && r != 0.0 && isfinite(r); ++iteration) {
        double h = 1.4901161193847656e-08 * fmax(1.0, fabs(x));
        batch_y[y_index] = x + h;
        double slope = ({{ b }}_row(row, time, batch_y, batch_p) - r) / h;
        if (!(slope != 0.0) || !isfinite(slope)) {
            break;
        }
        double next = x - r / slope;
        batch_y[y_index] = next;
        r = {{ b }}_row(row, time, batch_y, batch_p);
        double step = fabs(next - x);
        x = next;
        if (step <= {{ NAME }}_NEWTON_STEP_TOLERANCE * (1.0 + fabs(x))) {
            break;
        }
    }
    batch_y[y_index] = x;
}

