// The history value of channel `channel` at `query`: the oldest point before
// the history, the newest after it, the left point for a discrete source,
// and linear interpolation otherwise.
__device__ double {{ name }}_delay_read(const double *history, int channel, double query, int discrete)
{
    const int capacity = {{ NAME }}_DELAY_CAPACITY;
    int count = (int)history[0];
    int head = (int)history[1];
    const double *times = history + 2;
    const double *values = history + 2 + (long long)capacity * (long long)(1 + channel);
    if (count <= 0) {
        return NAN;
    }
    if (query <= times[head]) {
        return values[head];
    }
    int last = (head + count - 1) % capacity;
    if (query >= times[last]) {
        return values[last];
    }
    int low = 0;
    int high = count - 1;
    while (high - low > 1) {
        int middle = (low + high) / 2;
        if (times[(head + middle) % capacity] <= query) {
            low = middle;
        } else {
            high = middle;
        }
    }
    int lower = (head + low) % capacity;
    int upper = (head + high) % capacity;
    double span = times[upper] - times[lower];
    if (discrete || !(span > 0.0)) {
        return values[lower];
    }
    double fraction = (query - times[lower]) / span;
    return values[lower] + fraction * (values[upper] - values[lower]);
}

__device__ void {{ name }}_delay_append(double *history, double time, const double *sources)
{
    const int capacity = {{ NAME }}_DELAY_CAPACITY;
    int count = (int)history[0];
    int head = (int)history[1];
    if (count == capacity) {
        head = (head + 1) % capacity;
        count -= 1;
    }
    int slot = (head + count) % capacity;
    history[2 + slot] = time;
    for (int channel = 0; channel < {{ delays.count }}; ++channel) {
        history[2 + (long long)capacity * (long long)(1 + channel) + slot] = sources[channel];
    }
    history[0] = (double)(count + 1);
    history[1] = (double)head;
}
{%- endif %}

// Start every delay history at `time` from the initialized lane: the value
// before the start time is the source's start value.
extern "C" __global__ void {{ name }}_delay_init_batch(
    double time,
    double *y,
    double *p,
    double *history,
    int y_stride,
    int p_stride,
    int history_stride,
    int batch_count)
{
    int batch = blockIdx.x * blockDim.x + threadIdx.x;
    if (batch >= batch_count) {
        return;
    }
    double *batch_y = y + ((long long)batch * (long long)y_stride);
    double *batch_p = p + ((long long)batch * (long long)p_stride);
    double *batch_history = history + ((long long)batch * (long long)history_stride);
    (void)time;
    (void)batch_y;
    (void)batch_p;
    batch_history[0] = 0.0;
    batch_history[1] = 0.0;
{%- if delays.count > 0 %}
    const int value_parameter[{{ delays.count }}] = {{ int_list(delays.value_parameters) }};
    double sources[{{ delays.count }}];
    // The delayed values feed the rows their sources read: settle the
    // start-time fixed point a few times.
    for (int pass = 0; pass < 4; ++pass) {
        (void){{ name }}_refresh(time, batch_y, batch_p);
        {{ name }}_delay_sources(time, batch_y, batch_p, sources);
        int changed = 0;
        for (int channel = 0; channel < {{ delays.count }}; ++channel) {
            changed |= batch_p[value_parameter[channel]] != sources[channel];
            batch_p[value_parameter[channel]] = sources[channel];
        }
        if (!changed) {
            break;
        }
    }
    (void){{ name }}_refresh(time, batch_y, batch_p);
    {{ name }}_delay_sources(time, batch_y, batch_p, sources);
    {{ name }}_delay_append(batch_history, time, sources);
{%- endif %}
}

// Write every delayed value at `time` into its parameter slot.
extern "C" __global__ void {{ name }}_delay_apply_batch(
    double time,
    const double *y,
    double *p,
    const double *history,
    int y_stride,
    int p_stride,
    int history_stride,
    int batch_count)
{
    int batch = blockIdx.x * blockDim.x + threadIdx.x;
    if (batch >= batch_count) {
        return;
    }
    const double *batch_y = y + ((long long)batch * (long long)y_stride);
    double *batch_p = p + ((long long)batch * (long long)p_stride);
    const double *batch_history = history + ((long long)batch * (long long)history_stride);
    (void)time;
    (void)batch_y;
    (void)batch_p;
    (void)batch_history;
{%- if delays.count > 0 %}
    const int value_parameter[{{ delays.count }}] = {{ int_list(delays.value_parameters) }};
    const int discrete[{{ delays.count }}] = {{ int_list(delays.discrete) }};
    double delay_time[{{ delays.count }}];
    {{ name }}_delay_times(time, batch_y, batch_p, delay_time);
    for (int channel = 0; channel < {{ delays.count }}; ++channel) {
        batch_p[value_parameter[channel]] = {{ name }}_delay_read(batch_history, channel, time - delay_time[channel], discrete[channel]);
    }
{%- endif %}
}

// Record the accepted point at `time` (after the step that reached it, with
// the delayed values of `time` applied).
extern "C" __global__ void {{ name }}_delay_commit_batch(
    double time,
    double *y,
    const double *p,
    double *history,
    int y_stride,
    int p_stride,
    int history_stride,
    int batch_count)
{
    int batch = blockIdx.x * blockDim.x + threadIdx.x;
    if (batch >= batch_count) {
        return;
    }
    double *batch_y = y + ((long long)batch * (long long)y_stride);
    const double *batch_p = p + ((long long)batch * (long long)p_stride);
    double *batch_history = history + ((long long)batch * (long long)history_stride);
    (void)time;
    (void)batch_y;
    (void)batch_p;
    (void)batch_history;
{%- if delays.count > 0 %}
    double sources[{{ delays.count }}];
    (void){{ name }}_refresh(time, batch_y, batch_p);
    {{ name }}_delay_sources(time, batch_y, batch_p, sources);
    {{ name }}_delay_append(batch_history, time, sources);
{%- endif %}
}

